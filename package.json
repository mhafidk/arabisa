{
	"name": "learn-arabic-app",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"cap:sync": "vite build && cap sync",
		"android:open": "vite build && cap sync android && cap open android",
		"android:run": "vite build && cap sync android && cap run android",
		"android:bundle": "vite build && cap sync android && cd android && ./gradlew bundleRelease",
		"android:apk": "vite build && cap sync android && cd android && ./gradlew assembleRelease"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.6.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@capacitor/android": "^8.6.0",
		"@capacitor/core": "^8.6.0",
		"@fontsource-variable/figtree": "^5.3.0",
		"@fontsource-variable/noto-sans-arabic": "^5.3.0",
		"@lucide/svelte": "^1.71.0"
	}
}
